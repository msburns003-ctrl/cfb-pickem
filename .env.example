# Copy to .env and fill in. Never commit .env.
SUPABASE_URL=
SUPABASE_ANON_KEY=
PORT=5000
# Automatic scoring: on in production, off in local dev. Set on/off to override.
# Local dev uses the production database, so leave this unset locally.
AUTO_GRADE=

# "Forgot password" emails (optional; off unless ALL of these are set).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<your Gmail>,
# SMTP_PASS=<a Google app password, not your normal password>.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# The site's public address, used in reset links (e.g. https://cfb-pickem.pplx.app)
APP_URL=
# Random secret of 32+ characters that signs reset links. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RESET_TOKEN_SECRET=
