# Copy to .env and fill in. Never commit .env.
SUPABASE_URL=
# Server-only. Supabase → Project Settings → API Keys → secret key (sb_secret_...).
# The legacy service_role key also works. Never put the anon or publishable key here,
# and never commit a real value. Required once supabase_rls_lockdown.sql has been run.
# Until it is set, the server keeps using SUPABASE_ANON_KEY and logs an error.
SUPABASE_SERVICE_ROLE_KEY=
# Temporary fallback only. The server stops using this once SUPABASE_SERVICE_ROLE_KEY
# is a real secret key. The browser never uses it.
SUPABASE_ANON_KEY=
PORT=5000
# Automatic scoring: on in production, off in local dev. Set on/off to override.
# Local dev uses the production database, so leave this unset locally.
AUTO_GRADE=

# "Forgot password" emails (optional; off unless ALL of these are set).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<your Gmail>,
# SMTP_PASS=<a Google app password, not your normal password>.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# The site's public address, used in reset links (e.g. https://cfb-pickem.pplx.app)
APP_URL=
# Random secret of 32+ characters that signs reset links. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RESET_TOKEN_SECRET=
